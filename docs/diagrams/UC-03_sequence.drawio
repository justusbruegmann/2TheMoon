        <mxCell id="3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=14;" value="loop [while participating in the conversation]" vertex="1">
