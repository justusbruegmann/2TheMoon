        <mxCell id="2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontSize=24;fontStyle=1;" value="UC-03 — Use global chat" vertex="1">
          <mxGeometry height="35" width="700" x="30" y="15" as="geometry" />
