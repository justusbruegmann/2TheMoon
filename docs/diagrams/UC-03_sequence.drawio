        <mxCell id="13" edge="1" parent="1" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=14;labelBackgroundColor=#ffffff;verticalAlign=bottom;" value="Available messages with senders and timestamps">
