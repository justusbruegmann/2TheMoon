        <mxCell id="12" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7d6;strokeColor=#a38a35;fontSize=14;" value="Opens the chatbox" vertex="1">
          <mxGeometry height="40" width="190" x="35" y="130" as="geometry" />
