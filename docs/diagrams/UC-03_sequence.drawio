<mxfile host="Electron">
  <diagram id="global-chat" name="UC-03 Global Chat">
    <mxGraphModel dx="1184" dy="873" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
